# Public site URL used in sitemap, robots, and canonical links.
SITE_URL=https://clearwayjunkhaul.com

# Railway Postgres. When set, users, customers, emails, SMS, and calls persist.
DATABASE_URL=

# Email via Resend (https://resend.com)
# Without these keys, emails are stored in the admin notification log.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Clearway Junk Removal <hello@info.clearwayjunkhaul.com>

# SMS and voice via SignalWire (https://signalwire.com)
# Space is the host only, for example your-space.signalwire.com
SIGNALWIRE_SPACE=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_FROM_NUMBER=+13412503505
