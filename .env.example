# Email via Resend (https://resend.com)
# Without these keys, emails are stored in the ops notification log as mocked sends.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Clearway Junk Removal <hello@clearwayjunk.com>

# SMS via the phone company you choose (Telnyx, Twilio, Bandwidth, Plivo, or Vonage)
# Leave empty to log SMS as mocked sends in the ops dashboard.
SMS_PROVIDER=mock
SMS_API_KEY=
